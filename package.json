{
  "name": "studyapp-az104",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:validate": "node --experimental-strip-types scripts/validate-content.mjs",
    "sources:check": "node scripts/check-sources.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run content:validate && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dexie": "4.4.6"
  },
  "devDependencies": {
    "vite": "8.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "jsdom": "30.1.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "fake-indexeddb": "6.2.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "vite-plugin-pwa": "2.0.0",
    "wrangler": "4.148.0",
    "undici": "8.11.2"
  }
}
